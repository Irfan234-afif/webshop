          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_method}}/webshop.webshop.api.student.get_cart_by_student?student_id=CUST-00001-ABC123",
              "host": ["{{api_method}}"],
              "path": ["webshop.webshop.api.student.get_cart_by_student"],
              "query": [
                {
                  "key": "student_id",
                  "value": "CUST-00001-ABC123"
                }
              ]
            }
          }
        },
        {
          "name": "Get All Student Carts",
          "request": {
            "method": "GET",
