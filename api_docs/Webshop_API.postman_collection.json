{
  "info": {
    "name": "Webshop API Collection",
    "description": "Complete API collection for Frappe Webshop with student management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "api_method",
      "value": "{{base_url}}/api/method",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone_number\": \"+1234567890\",\n  \"password\": \"SecurePassword123\",\n  \"students\": [\n    {\n      \"student_name\": \"Alice Doe\",\n      \"school_unit\": \"High School\",\n      \"grade_level\": \"Grade 10\"\n    },\n    {\n      \"student_name\": \"Bob Doe\",\n      \"school_unit\": \"Elementary\",\n      \"grade_level\": \"Grade 5\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{api_method}}/webshop.webshop.api.auth.register",
              "host": ["{{api_method}}"],
              "path": ["webshop.webshop.api.auth.register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"SecurePassword123\"\n}"
            },
            "url": {
              "raw": "{{api_method}}/webshop.webshop.api.auth.login",
              "host": ["{{api_method}}"],
              "path": ["webshop.webshop.api.auth.login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_method}}/webshop.webshop.api.auth.get_current_user",
              "host": ["{{api_method}}"],
              "path": ["webshop.webshop.api.auth.get_current_user"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{api_method}}/webshop.webshop.api.auth.logout",
              "host": ["{{api_method}}"],
              "path": ["webshop.webshop.api.auth.logout"]
            }
          }
        },
        {
          "name": "Check Email Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_method}}/webshop.webshop.api.auth.check_email_availability?email=newuser@example.com",
              "host": ["{{api_method}}"],
              "path": ["webshop.webshop.api.auth.check_email_availability"],
              "query": [
                {
                  "key": "email",
                  "value": "newuser@example.com"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Student Management",
