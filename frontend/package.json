{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8001",
    "build": "vite build",
    "build-frontend": "vite build --base=/assets/webshop/frontend/ && npm run copy-html-entry",
    "copy-html-entry": "cp ../webshop/public/frontend/index.html ../webshop/www/_webshop.html",
    "preview": "vite preview --host 0.0.0.0 --port 8001",
    "test-local": "cypress open --e2e --browser chrome",
    "test": "npx cypress run --record --key fa50a4df-569e-41bc-8600-850331fd1630",
    "type-check": "vue-tsc --build",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "frappe-ui": "^0.1.238",
    "pinia": "^3.0.4",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.25",
    "vue-cookies": "^1.8.6",
    "vue-router": "^4.6.3",
    "vue-tel-input": "^9.6.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.23",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "sass-embedded": "^1.97.3",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.9.0",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.5"
  }
}
